# RoboHero ESP8266: 80 MHz, 2 MB DIO flash, custom partitions.

CONFIG_ESP8266_DEFAULT_CPU_FREQ_80=y
# CONFIG_ESP8266_DEFAULT_CPU_FREQ_160 is not set

# Software PWM on GPIO12 uses timer0; NMI WDT cannot share it.
# CONFIG_ESP8266_NMI_WDT is not set

CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_ESP8266_WIFI_NVS_ENABLED=y

# HTTP + Wi-Fi need spare lwIP sockets and TCP/IP task stack.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=3072

# Browsers send large Cookie/User-Agent/sec-ch-ua headers
# (default 512 is too small).
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024

# External voltage on TOUT / A0 (must be < 255).
CONFIG_ESP_PHY_INIT_DATA_VDD33_CONST=33

# MQTT over TCP only (no TLS / websocket).
# CONFIG_MQTT_TRANSPORT_SSL is not set
# CONFIG_MQTT_TRANSPORT_WEBSOCKET is not set
# CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE is not set

# Enable mDNS discovery
CONFIG_ENABLE_MDNS=y


