!include "MUI2.nsh"

Name "RoboHero Motion @PROJECT_VERSION@"
OutFile "@CMAKE_CURRENT_BINARY_DIR@/robohero_motion-setup-@PROJECT_VERSION@.exe"
InstallDir "$PROGRAMFILES64\RoboHero Motion"
InstallDirRegKey HKLM "Software\Selfso\RoboHeroMotion" "InstallDir"
RequestExecutionLevel admin
Unicode True
SetCompressor zlib
BrandingText "RoboHero Motion v@PROJECT_VERSION@"

VIProductVersion "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@.0"
VIAddVersionKey "ProductName" "RoboHero Motion"
VIAddVersionKey "CompanyName" "Charles Chiou"
VIAddVersionKey "LegalCopyright" "Copyright (C) 2026, Charles Chiou"
VIAddVersionKey "FileDescription" "RoboHero Motion Setup"
VIAddVersionKey "FileVersion" "@PROJECT_VERSION@"
VIAddVersionKey "ProductVersion" "@PROJECT_VERSION@"
VIAddVersionKey "OriginalFilename" "robohero_motion.exe"
VIAddVersionKey "InternalName" "robohero_motion"

!define MUI_ABORTWARNING
!define MUI_ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/robohero_icon.ico"
!define MUI_UNICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/robohero_icon.ico"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!define MUI_FINISHPAGE_RUN "$INSTDIR\robohero_motion.exe"
!define MUI_FINISHPAGE_RUN_TEXT "Launch RoboHero Motion"
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_WELCOME
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_UNPAGE_FINISH

!insertmacro MUI_LANGUAGE "English"

Function .onInit
    SetRegView 64
    SetShellVarContext all
FunctionEnd

Function un.onInit
    SetRegView 64
    SetShellVarContext all
FunctionEnd

Section "RoboHero Motion" SecMain
    SectionIn RO
    SetRegView 64
    SetShellVarContext all

    SetOutPath "$INSTDIR"
    File "@CMAKE_CURRENT_BINARY_DIR@/robohero_motion.exe"
    File "@CMAKE_CURRENT_SOURCE_DIR@/assets/robohero_icon.ico"
    File "@CMAKE_CURRENT_BINARY_DIR@/Qt6Core.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/Qt6Gui.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/Qt6Widgets.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/Qt6OpenGL.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/Qt6OpenGLWidgets.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/libstdc++-6.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/libgcc_s_seh-1.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/libwinpthread-1.dll"

    SetOutPath "$INSTDIR\platforms"
    File "@CMAKE_CURRENT_BINARY_DIR@/platforms/qwindows.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/platforms/qdirect2d.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/platforms/qminimal.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/platforms/qoffscreen.dll"

    SetOutPath "$INSTDIR\styles"
    File "@CMAKE_CURRENT_BINARY_DIR@/styles/qmodernwindowsstyle.dll"

    SetOutPath "$INSTDIR"
    WriteRegStr HKLM "Software\Selfso\RoboHeroMotion" "InstallDir" "$INSTDIR"
    WriteRegStr HKLM "Software\Selfso\RoboHeroMotion" "Version" "@PROJECT_VERSION@"
    WriteUninstaller "$INSTDIR\Uninstall.exe"

    CreateDirectory "$SMPROGRAMS\RoboHero Motion"
    CreateShortcut "$SMPROGRAMS\RoboHero Motion\RoboHero Motion.lnk" "$INSTDIR\robohero_motion.exe" "" "$INSTDIR\robohero_motion.exe" 0
    CreateShortcut "$SMPROGRAMS\RoboHero Motion\Uninstall RoboHero Motion.lnk" "$INSTDIR\Uninstall.exe" "" "$INSTDIR\Uninstall.exe" 0
    CreateShortcut "$DESKTOP\RoboHero Motion.lnk" "$INSTDIR\robohero_motion.exe" "" "$INSTDIR\robohero_motion.exe" 0

    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroMotion" "DisplayName" "RoboHero Motion"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroMotion" "DisplayVersion" "@PROJECT_VERSION@"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroMotion" "Publisher" "Charles Chiou"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroMotion" "UninstallString" "$\"$INSTDIR\Uninstall.exe$\""
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroMotion" "QuietUninstallString" "$\"$INSTDIR\Uninstall.exe$\" /S"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroMotion" "DisplayIcon" "$INSTDIR\robohero_motion.exe,0"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroMotion" "InstallLocation" "$INSTDIR"
    WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroMotion" "NoModify" 1
    WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroMotion" "NoRepair" 1
SectionEnd

Section "Uninstall"
    SetRegView 64
    SetShellVarContext all

    Delete "$INSTDIR\robohero_motion.exe"
    Delete "$INSTDIR\robohero_motion.exe.old"
    Delete "$INSTDIR\robohero_icon.ico"
    Delete "$INSTDIR\Qt6Core.dll"
    Delete "$INSTDIR\Qt6Gui.dll"
    Delete "$INSTDIR\Qt6Widgets.dll"
    Delete "$INSTDIR\Qt6OpenGL.dll"
    Delete "$INSTDIR\Qt6OpenGLWidgets.dll"
    Delete "$INSTDIR\libstdc++-6.dll"
    Delete "$INSTDIR\libgcc_s_seh-1.dll"
    Delete "$INSTDIR\libwinpthread-1.dll"
    Delete "$INSTDIR\Uninstall.exe"

    Delete "$INSTDIR\platforms\qwindows.dll"
    Delete "$INSTDIR\platforms\qdirect2d.dll"
    Delete "$INSTDIR\platforms\qminimal.dll"
    Delete "$INSTDIR\platforms\qoffscreen.dll"
    RMDir "$INSTDIR\platforms"

    Delete "$INSTDIR\styles\qmodernwindowsstyle.dll"
    RMDir "$INSTDIR\styles"

    Delete "$DESKTOP\RoboHero Motion.lnk"
    Delete "$SMPROGRAMS\RoboHero Motion\RoboHero Motion.lnk"
    Delete "$SMPROGRAMS\RoboHero Motion\Uninstall RoboHero Motion.lnk"
    RMDir "$SMPROGRAMS\RoboHero Motion"

    RMDir "$INSTDIR"

    DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroMotion"
    DeleteRegKey HKLM "Software\Selfso\RoboHeroMotion"
SectionEnd
