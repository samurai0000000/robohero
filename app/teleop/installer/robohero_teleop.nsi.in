!include "MUI2.nsh"

Name "RoboHero Teleop @PROJECT_VERSION@"
OutFile "@CMAKE_CURRENT_BINARY_DIR@/robohero_teleop-setup-@PROJECT_VERSION@.exe"
InstallDir "$PROGRAMFILES64\RoboHero Teleop"
InstallDirRegKey HKLM "Software\Selfso\RoboHeroTeleop" "InstallDir"
RequestExecutionLevel admin
Unicode True
SetCompressor zlib
BrandingText "RoboHero Teleop v@PROJECT_VERSION@"

VIProductVersion "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@.0"
VIAddVersionKey "ProductName" "RoboHero Teleop"
VIAddVersionKey "CompanyName" "Charles Chiou"
VIAddVersionKey "LegalCopyright" "Copyright (C) 2026, Charles Chiou"
VIAddVersionKey "FileDescription" "RoboHero Teleop Setup"
VIAddVersionKey "FileVersion" "@PROJECT_VERSION@"
VIAddVersionKey "ProductVersion" "@PROJECT_VERSION@"
VIAddVersionKey "OriginalFilename" "robohero_teleop.exe"
VIAddVersionKey "InternalName" "robohero_teleop"

!define MUI_ABORTWARNING
!define MUI_ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/robohero_icon.ico"
!define MUI_UNICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/robohero_icon.ico"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!define MUI_FINISHPAGE_RUN "$INSTDIR\robohero_teleop.exe"
!define MUI_FINISHPAGE_RUN_TEXT "Launch RoboHero Teleop"
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_WELCOME
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_UNPAGE_FINISH

!insertmacro MUI_LANGUAGE "English"

Function .onInit
    SetRegView 64
    SetShellVarContext all
FunctionEnd

Function un.onInit
    SetRegView 64
    SetShellVarContext all
FunctionEnd

Section "RoboHero Teleop" SecMain
    SectionIn RO
    SetRegView 64
    SetShellVarContext all

    SetOutPath "$INSTDIR"
    File "@CMAKE_CURRENT_BINARY_DIR@/robohero_teleop.exe"
    File "@CMAKE_CURRENT_SOURCE_DIR@/assets/robohero_icon.ico"
    File "@CMAKE_CURRENT_BINARY_DIR@/onnxruntime.dll"
    File /nonfatal "@CMAKE_CURRENT_BINARY_DIR@/onnxruntime_providers_shared.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/Qt6Core.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/Qt6Gui.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/Qt6Widgets.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/Qt6OpenGL.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/Qt6OpenGLWidgets.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/libstdc++-6.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/libgcc_s_seh-1.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/libwinpthread-1.dll"

    SetOutPath "$INSTDIR\platforms"
    File "@CMAKE_CURRENT_BINARY_DIR@/platforms/qwindows.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/platforms/qdirect2d.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/platforms/qminimal.dll"
    File "@CMAKE_CURRENT_BINARY_DIR@/platforms/qoffscreen.dll"

    SetOutPath "$INSTDIR\styles"
    File "@CMAKE_CURRENT_BINARY_DIR@/styles/qmodernwindowsstyle.dll"

    SetOutPath "$INSTDIR"
    WriteRegStr HKLM "Software\Selfso\RoboHeroTeleop" "InstallDir" "$INSTDIR"
    WriteRegStr HKLM "Software\Selfso\RoboHeroTeleop" "Version" "@PROJECT_VERSION@"
    WriteUninstaller "$INSTDIR\Uninstall.exe"

    CreateDirectory "$SMPROGRAMS\RoboHero Teleop"
    CreateShortcut "$SMPROGRAMS\RoboHero Teleop\RoboHero Teleop.lnk" "$INSTDIR\robohero_teleop.exe" "" "$INSTDIR\robohero_teleop.exe" 0
    CreateShortcut "$SMPROGRAMS\RoboHero Teleop\Uninstall RoboHero Teleop.lnk" "$INSTDIR\Uninstall.exe" "" "$INSTDIR\Uninstall.exe" 0
    CreateShortcut "$DESKTOP\RoboHero Teleop.lnk" "$INSTDIR\robohero_teleop.exe" "" "$INSTDIR\robohero_teleop.exe" 0

    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroTeleop" "DisplayName" "RoboHero Teleop"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroTeleop" "DisplayVersion" "@PROJECT_VERSION@"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroTeleop" "Publisher" "Charles Chiou"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroTeleop" "UninstallString" "$\"$INSTDIR\Uninstall.exe$\""
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroTeleop" "QuietUninstallString" "$\"$INSTDIR\Uninstall.exe$\" /S"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroTeleop" "DisplayIcon" "$INSTDIR\robohero_teleop.exe,0"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroTeleop" "InstallLocation" "$INSTDIR"
    WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroTeleop" "NoModify" 1
    WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroTeleop" "NoRepair" 1
SectionEnd

Section "Uninstall"
    SetRegView 64
    SetShellVarContext all

    Delete "$INSTDIR\robohero_teleop.exe"
    Delete "$INSTDIR\robohero_teleop.exe.old"
    Delete "$INSTDIR\robohero_icon.ico"
    Delete "$INSTDIR\onnxruntime.dll"
    Delete "$INSTDIR\onnxruntime_providers_shared.dll"
    Delete "$INSTDIR\Qt6Core.dll"
    Delete "$INSTDIR\Qt6Gui.dll"
    Delete "$INSTDIR\Qt6Widgets.dll"
    Delete "$INSTDIR\Qt6OpenGL.dll"
    Delete "$INSTDIR\Qt6OpenGLWidgets.dll"
    Delete "$INSTDIR\libstdc++-6.dll"
    Delete "$INSTDIR\libgcc_s_seh-1.dll"
    Delete "$INSTDIR\libwinpthread-1.dll"
    Delete "$INSTDIR\Uninstall.exe"

    Delete "$INSTDIR\platforms\qwindows.dll"
    Delete "$INSTDIR\platforms\qdirect2d.dll"
    Delete "$INSTDIR\platforms\qminimal.dll"
    Delete "$INSTDIR\platforms\qoffscreen.dll"
    RMDir "$INSTDIR\platforms"

    Delete "$INSTDIR\styles\qmodernwindowsstyle.dll"
    RMDir "$INSTDIR\styles"

    Delete "$DESKTOP\RoboHero Teleop.lnk"
    Delete "$SMPROGRAMS\RoboHero Teleop\RoboHero Teleop.lnk"
    Delete "$SMPROGRAMS\RoboHero Teleop\Uninstall RoboHero Teleop.lnk"
    RMDir "$SMPROGRAMS\RoboHero Teleop"

    RMDir "$INSTDIR"

    DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoboHeroTeleop"
    DeleteRegKey HKLM "Software\Selfso\RoboHeroTeleop"
SectionEnd
