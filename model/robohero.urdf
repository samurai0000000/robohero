<robot name="robohero">

  <!-- ==================== Materials ==================== -->
  <material name="armor_red">
    <color rgba="0.84 0.23 0.18 1.0"/>
  </material>

  <material name="chest_gold">
    <color rgba="0.86 0.68 0.48 1.0"/>
  </material>

  <material name="servo_black">
    <color rgba="0.16 0.17 0.20 1.0"/>
  </material>

  <material name="reactor_cyan">
    <color rgba="0.18 0.82 1.0 1.0"/>
  </material>

  <material name="lens_dark">
    <color rgba="0.08 0.09 0.11 0.95"/>
  </material>

  <material name="metal_gray">
    <color rgba="0.35 0.37 0.40 1.0"/>
  </material>

  <!-- ==================== Base / Torso Link ==================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.160"/>
      <inertia ixx="0.00018" ixy="0.0" ixz="0.0" iyy="0.00015" iyz="0.0" izz="0.00012"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.076 0.080"/>
      </geometry>
      <material name="armor_red"/>
    </visual>
    <!-- Gold Chest Armor Plate -->
    <visual>
      <origin xyz="0.029 0 0.008" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.052 0.046"/>
      </geometry>
      <material name="chest_gold"/>
    </visual>
    <!-- Arc Reactor Core -->
    <visual>
      <origin xyz="0.032 0 0.012" rpy="0 0 0"/>
      <geometry>
        <box size="0.003 0.020 0.020"/>
      </geometry>
      <material name="reactor_cyan"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.076 0.080"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== Head (Channel 16) ==================== -->
  <joint name="head_yaw_joint" type="revolute">
    <origin xyz="0 0 0.046" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="head_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.9756" upper="0.9233" effort="1.2" velocity="3.14"/>
