<robot name="robohero">

  <!-- ==================== Materials ==================== -->
  <material name="slate_dark">
    <color rgba="0.12 0.16 0.23 1.0"/>
  </material>

  <material name="cyan_accent">
    <color rgba="0.02 0.71 0.83 1.0"/>
  </material>

  <material name="blue_accent">
    <color rgba="0.23 0.51 0.96 1.0"/>
  </material>

  <material name="metal_gray">
    <color rgba="0.45 0.48 0.53 1.0"/>
  </material>

  <material name="light_gray">
    <color rgba="0.82 0.85 0.90 1.0"/>
  </material>

  <material name="visor_black">
    <color rgba="0.05 0.05 0.08 0.95"/>
  </material>

  <!-- ==================== Base / Torso Link ==================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.160"/>
      <inertia ixx="0.00018" ixy="0.0" ixz="0.0" iyy="0.00015" iyz="0.0" izz="0.00012"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.076 0.080"/>
      </geometry>
      <material name="slate_dark"/>
    </visual>
    <!-- Chest decoration visual -->
    <visual>
      <origin xyz="0.029 0 0.010" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.048 0.040"/>
      </geometry>
      <material name="cyan_accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.076 0.080"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== Head (Channel 16) ==================== -->
  <joint name="head_yaw_joint" type="revolute">
    <origin xyz="0 0 0.046" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="head_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="0.8" velocity="3.14"/>
